GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
DATABASE_URL=file:./dev.db

# RunSignup race search (optional). Public Get Races works without keys.
# RUNSIGNUP_API_KEY=
# RUNSIGNUP_API_SECRET=

# Production (Fly): persist SQLite + profile on the volume
# DATA_DIR=/data
# DATABASE_URL=file:/data/turnova.db

# Single-user password gate. Leave unset for local dev (no login).
# APP_PASSWORD=
# AUTH_SECRET=

# Garmin Connect is linked in the UI (email/password once). Tokens live in SQLite.
# Do not put Garmin email/password here.

# Strava API app: https://www.strava.com/settings/api
# Authorization Callback Domain: localhost (for local dev)
# Redirect URI must match exactly:
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# Standard Tier read limits (self-upgraded dashboard). Override if yours differ.
# Default / older apps may be 100 / 15m and 1000 / day — set those if you get 429s early.
STRAVA_READ_LIMIT_15M=200
STRAVA_READ_LIMIT_DAILY=2000
STRAVA_OVERALL_LIMIT_15M=400
STRAVA_OVERALL_LIMIT_DAILY=4000
# Stop each chunk this many requests before the ceiling
STRAVA_RATE_HEADROOM=15
